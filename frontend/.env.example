# 前端配置示例。复制为 frontend/.env.local 后按需修改。
#
# 全部留空时（默认）：底图用 OpenStreetMap，地形用裸椭球 ellipsoid://，
# 3D Tiles 关闭。见 src/config.ts。

# Cesium ion token。留空则不加载 ion 资产。
# VITE_ION_TOKEN=

# 底图影像。留空时：有 ion token 用 ion://2，否则用 OpenStreetMap 瓦片。
# VITE_IMAGERY_URL=
# VITE_IMAGERY_ATTRIBUTION=

# 地形。留空时：有 ion token 用 ion://1，否则用 ellipsoid://。
# VITE_TERRAIN_URL=
# VITE_TERRAIN_ATTRIBUTION=

# 3D Tiles。留空则不加载。
# VITE_TILESET_URL=
# VITE_TILESET_ATTRIBUTION=

# 开发期 vite 代理指向的后端地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8000