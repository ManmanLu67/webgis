# 后端配置示例。复制为 backend/.env.local 后按需修改。
# 所有变量都带 WEBGIS_ 前缀，字段定义见 app/config.py。
#
# 改完记得重启进程：这些值在启动时读一次。

# 数据库连接串。默认 SQLite；compose 里指向 PostGIS
WEBGIS_DATABASE_URL=sqlite:///./catalog.db

# 插件目录与数据目录（COG、上传原件）
# WEBGIS_PLUGINS_DIR=./plugins
# WEBGIS_DATA_DIR=./data

# 默认切片发布器：titiler | geoserver
WEBGIS_DEFAULT_PUBLISHER=titiler

# 是否在 API 进程内启动入库 worker
WEBGIS_WORKER_ENABLED=false

# --- 切片服务 ---
# 挂载前缀。FastAPI 挂在这里，compose 里 Caddy 原样透传，不剥前缀。
WEBGIS_TILE_SERVICE_PREFIX=/cog

# 可用瓦片矩阵集，逗号分隔
WEBGIS_TILE_MATRIX_SETS=WebMercatorQuad,WGS1984Quad

# 切片服务前面是否真的有缓存层。
# 默认 false：/tiles/timing 必须如实报告 "none"（注意它不在 /cog 下，
# 是平台自己的探测端点）。
# 只有真的在 TiTiler 前部署了缓存才置为 true，否则那个数字是假的。
WEBGIS_TILE_CACHE_ENABLED=false

# 对外基地址。用于拼图层服务地址；留空则用请求的 Host 头
WEBGIS_PUBLIC_BASE_URL=

# --- 切片输入 ---
# 允许拉取的远程 COG 主机，白名单，逗号分隔。空 = 全部拒绝。
# 配合 SSRF 防护使用，见 app/tiles/paths.py
WEBGIS_REMOTE_COG_HOSTS=

# --- 上传 ---
# 上传原件大小上限（字节）。默认 512 MiB
WEBGIS_MAX_UPLOAD_BYTES=536870912

# --- 需 Key 的数据源 ---
#
# plugin.yaml 里只写需要哪些凭据的**名字**（credentials），值在这里给。
# 变量名 = WEBGIS_PROVIDER_SECRETS_ + 插件 id 转大写；值是 JSON 对象。
# 不设 = 该源停在 needs_config、不出现在界面里（宪章 C4）。
#
# 例：天地图
# WEBGIS_PROVIDER_SECRETS_TIANDITU={"tk": "你的天地图 Key"}
# 例：Google Map Tiles（务必在 Cloud Console 里限制 referrer，见 README）
# WEBGIS_PROVIDER_SECRETS_GOOGLE_TILES={"key": "你的 Google API Key"}
# 例：腾讯位置服务
# WEBGIS_PROVIDER_SECRETS_TENCENT_MAP={"key": "你的腾讯 Key"}
#
# ⚠ 天地图是 KVP WMTS：每个瓦片请求都要带 tk，所以 Key 必然会随图层描述
# 到达浏览器。这是服务方协议要求，靠"藏起来"是藏不住的 —— 请在服务方后台
# 给 Key 加上来源限制（referrer / IP 白名单）。理由见 README「数据来源与署名」。
#
# 注意：pydantic 会**静默忽略**拼错或已不存在的变量名。所以变量名写错不会报错，
# 只是没效果。tests/test_settings.py 会核对本文件里的每个名字都真实存在。