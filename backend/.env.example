# 后端配置示例。复制为 backend/.env.local 后按需修改。
# 所有变量都带 WEBGIS_ 前缀（见 app/config.py）。

# 默认 SQLite；compose 里指向 PostGIS
WEBGIS_DATABASE_URL=sqlite:///./catalog.db

# 插件目录与数据目录（COG、上传原件）
# WEBGIS_PLUGINS_DIR=./plugins
# WEBGIS_DATA_DIR=./data

# 默认切片发布器：titiler | geoserver
WEBGIS_DEFAULT_PUBLISHER=titiler

# 是否在 API 进程内启动入库 worker
WEBGIS_WORKER_ENABLED=false

# TiTiler 挂载前缀（阶段 1 起生效）
# WEBGIS_TITILER_PREFIX=/cog

# TiTiler 自身是否有缓存层。默认没有：/tiles/timing 必须如实报告 "none"。
# 只有在 TiTiler 前真的部署了缓存时才置为 true。
WEBGIS_TITILER_CACHE=none